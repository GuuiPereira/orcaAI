{
  "expo": {
    "name": "OrçaAI",
    "slug": "orcaai",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.guuipereira.orcaai"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "@sentry/react-native/expo",
      [
        "expo-audio",
        {
          "microphonePermission": "O OrçaAI usa o microfone para você falar a descrição do orçamento em vez de digitar."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O OrçaAI usa a câmera para você fotografar um bilhete ou anotação com o texto do orçamento.",
          "photosPermission": "O OrçaAI acessa suas fotos para você escolher uma imagem ou print com o texto do orçamento.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55bf003f-6760-4413-8844-fe5ccc1d33ab"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/55bf003f-6760-4413-8844-fe5ccc1d33ab"
    }
  }
}
