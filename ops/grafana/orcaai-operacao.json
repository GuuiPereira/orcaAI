            "uid": "${DS_ORCAAI}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "select day::timestamp as time, model_version || ' p50' as metric, p50_ms as value\nfrom metrics_ai_latency_daily where $__timeFilter(day)\nunion all\nselect day::timestamp, model_version || ' p95', p95_ms\nfrom metrics_ai_latency_daily where $__timeFilter(day)\norder by 1"
