          "rawSql": "select day::timestamp as time,\n  median_seconds_to_share / 60.0 as \"Mediana\",\n  p90_seconds_to_share / 60.0 as \"p90\"\nfrom metrics_time_to_share_daily\nwhere $__timeFilter(day)\norder by 1"
        }
