          "rawSql": "select day::timestamp as time,\n  sum(succeeded) as \"Concluídas\",\n  sum(failed) as \"Falhas\",\n  sum(invalid_schema) as \"Schema inválido\"\nfrom metrics_ai_daily\nwhere $__timeFilter(day)\ngroup by 1\norder by 1"
