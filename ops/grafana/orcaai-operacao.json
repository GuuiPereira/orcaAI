    {
      "type": "stat",
      "title": "Custo de IA no mês (US$)",
      "description": "Interpretação + áudio/imagem (Fase 4A), estimado pela tabela de preços. Atenção: o custo de interpretação é gravado em centavos INTEIROS e arredonda para 0 com modelos baratos.",
      "id": 2,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_ORCAAI}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_ORCAAI}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select coalesce(sum(total_cost_cents), 0) / 100.0 as \"US$\"\nfrom metrics_cost_monthly\nwhere month = date_trunc('month', now())::date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
