    {
      "type": "timeseries",
      "title": "Custo diário (US$)",
      "description": "",
      "id": 6,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_ORCAAI}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_ORCAAI}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "select day::timestamp as time, sum(cost_cents) / 100.0 as \"Interpretação\"\nfrom metrics_ai_daily\nwhere $__timeFilter(day)\ngroup by 1\norder by 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_ORCAAI}"
          },
          "editorMode": "code",
