    {
      "type": "table",
      "title": "Uso por organização no período",
      "description": "Identificação: id curto + nome da empresa (decisão de 2026-10-15). Pode ser dado pessoal se o testador usou o próprio nome - só o operador vê.",
      "id": 10,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_ORCAAI}"
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_ORCAAI}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select\n  organization_short_id as \"Org\",\n  trade_name as \"Empresa\",\n  sum(quotes_created) as \"Criados\",\n  sum(interpretations) as \"Interpretações\",\n  sum(quotes_issued) as \"Emitidos\",\n  sum(tokens) as \"Tokens\",\n  sum(cost_cents) / 100.0 as \"Custo interpretação (US$)\",\n  max(day) as \"Último dia ativo\"\nfrom metrics_usage_daily\nwhere $__timeFilter(day)\ngroup by 1, 2\norder by \"Criados\" desc"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "row",
      "title": "Funil",
      "collapsed": false,
      "id": 11,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "barchart",
      "title": "Funil no período",
      "description": "criado → interpretado → emitido → compartilhado → enviado/aprovado. 'compartilhado' só aparece depois que o app com o evento chegar aos aparelhos.",
      "id": 12,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_ORCAAI}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_ORCAAI}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select step as \"Etapa\", sum(total) as \"Orçamentos\"\nfrom metrics_funnel_daily\nwhere $__timeFilter(day)\ngroup by step\norder by case step when 'criado' then 1 when 'interpretado' then 2 when 'emitido' then 3 when 'compartilhado' then 4 when 'enviado' then 5 when 'aprovado' then 6 when 'recusado' then 7 when 'expirado' then 8 else 9 end"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "Etapa",
        "showValue": "always",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tempo até compartilhar (minutos)",
      "description": "North star do PRD §11: do orçamento criado ao 1º compartilhamento do PDF, pelo dia de criação.",
      "id": 13,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_ORCAAI}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
