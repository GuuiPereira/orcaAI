    {
      "type": "timeseries",
      "title": "Leituras de áudio/imagem: resultado",
      "description": "",
      "id": 18,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_ORCAAI}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 10,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_ORCAAI}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "select day::timestamp as time, kind || ' ok' as metric, sum(succeeded) as value\nfrom metrics_extractions_daily where $__timeFilter(day) group by 1, 2\nunion all\nselect day::timestamp, kind || ' sem texto', sum(no_text)\nfrom metrics_extractions_daily where $__timeFilter(day) group by 1, 2\nunion all\nselect day::timestamp, kind || ' outras falhas', sum(failed - no_text)\nfrom metrics_extractions_daily where $__timeFilter(day) group by 1, 2\norder by 1"
        }
      ],
      "fieldConfig": {
