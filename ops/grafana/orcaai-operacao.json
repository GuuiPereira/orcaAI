          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select\n  prompt_version as \"Prompt\",\n  quotes_compared as \"Emissões comparadas\",\n  pct_fully_accepted as \"% aceito sem alteração\",\n  avg_fields_changed as \"Média campos alterados\",\n  avg_items_added as \"Média itens adicionados\",\n  avg_items_removed as \"Média itens removidos\"\nfrom metrics_ai_quality_by_prompt\norder by prompt_version desc"
        }
      ],
      "fieldConfig": {
