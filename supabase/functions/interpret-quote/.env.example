# Copy to .env.local (gitignored) for local development with
# `supabase functions serve --env-file supabase/functions/interpret-quote/.env.local`.

OPENAI_API_KEY=
# Required - no default, per docs/ARCHITECTURE.md §3 ("modelo configurável
# por ambiente, sem acoplar regras ao nome de um modelo").
OPENAI_MODEL=

# Optional: only set both to get a non-null estimated_cost_cents on
# ai_interpretations. Values are USD cents per 1,000,000 tokens.
OPENAI_INPUT_COST_CENTS_PER_1M=
OPENAI_OUTPUT_COST_CENTS_PER_1M=
