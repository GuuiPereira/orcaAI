# Copy to .env.local (gitignored) for local development with
# `supabase functions serve --env-file supabase/functions/interpret-quote/.env.local`.

OPENAI_API_KEY=
# Required - no default, per docs/ARCHITECTURE.md §3 ("modelo configurável
# por ambiente, sem acoplar regras ao nome de um modelo"). Can be overridden
# per-request via the optional `model` field in the request body (must be
# one of the models in packages/shared/src/ai/model-pricing.ts) - handy for
# comparing models via tools/ai-playground.html.
OPENAI_MODEL=

# No cost env vars needed anymore: estimated_cost_cents is computed from
# packages/shared/src/ai/model-pricing.ts, keyed by whichever model actually
# served the request. Unknown models just get a null cost instead of a
# guessed one - update that file when OpenAI's pricing changes.
